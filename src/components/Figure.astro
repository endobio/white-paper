---
interface Props {
  src?: string;
  alt?: string;
  caption: string;
  source?: string;
}

const { src, alt = '', caption, source } = Astro.props;
const assetSrc = src?.startsWith('/')
  ? `${import.meta.env.BASE_URL}${src.slice(1)}`
  : src;
---

<figure class="publication-figure">
  <div class="publication-figure__media">
    {assetSrc ? <img src={assetSrc} alt={alt} loading="lazy" /> : <slot />}
  </div>
  <figcaption>
    <span class="publication-figure__number" aria-hidden="true"></span>
    <span>{caption}</span>
    {source && <span class="publication-figure__source"> Source: {source}</span>}
  </figcaption>
</figure>

<style>
  .publication-figure {
    margin: 2.75rem 0;
    break-inside: avoid;
  }
  .publication-figure__media {
    padding: clamp(1rem, 4vw, 2.25rem);
    border: 1px solid var(--color-rule);
    background: var(--color-surface-soft);
  }
  .publication-figure__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 0.8rem;
    color: var(--color-ink-muted);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.55;
  }
  .publication-figure__number::before {
    content: 'Figure ' counter(publication-figure) '. ';
    color: var(--color-ink);
    font-weight: 700;
  }
  .publication-figure { counter-increment: publication-figure; }
  .publication-figure__source { font-style: italic; }
  @media print { .publication-figure__media { background: transparent; } }
</style>
