---
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Metadata {
  title: string;
  description: string;
  authors: string[];
  date: Date;
  version: string;
  abstract: string;
  status: 'draft' | 'preprint' | 'published';
}

interface Props {
  metadata: Metadata;
  headings: Heading[];
}

const { metadata, headings } = Astro.props;
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
const published = metadata.date.toLocaleDateString('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = import.meta.env.BASE_URL;
const socialImage = new URL(`${home}og.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metadata.description} />
    <meta name="theme-color" content="#f5f3ec" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content={`${metadata.title} — An EndoBio white paper`} />
    <meta property="article:published_time" content={metadata.date.toISOString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`${metadata.title} — An EndoBio white paper`} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${home}endobio-logo.svg`} />
    <title>{metadata.title} — EndoBio</title>
  </head>
  <body>
    <a class="skip-link" href="#paper">Skip to paper</a>
    <header class="site-header">
      <a class="wordmark" href={home} aria-label="EndoBio white paper home">
        <img class="wordmark__mark" src={`${home}endobio-logo.svg`} alt="" />
        <span>EndoBio</span>
      </a>
      <div class="site-header__meta">
        <span>Research publication</span>
        <button class="print-button" type="button" onclick="window.print()">Print / save PDF</button>
      </div>
    </header>

    <div class="publication-shell">
      <aside class="toc" aria-label="Table of contents">
        <p class="toc__label">Contents</p>
        <ol>
          {toc.map((heading) => (
            <li class:list={[{ 'toc__subsection': heading.depth === 3 }]}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </aside>

      <main id="paper" class="paper">
        <header class="paper-header">
          <p class="paper-header__eyebrow">EndoBio white paper</p>
          <h1>{metadata.title}</h1>
          <p class="paper-header__description">{metadata.description}</p>
          <dl class="paper-header__metadata">
            <div><dt>Authors</dt><dd>{metadata.authors.join(', ')}</dd></div>
            <div><dt>Published</dt><dd>{published}</dd></div>
            <div><dt>Version</dt><dd>{metadata.version}</dd></div>
            <div><dt>Status</dt><dd>{metadata.status}</dd></div>
          </dl>
        </header>

        <section class="abstract" aria-labelledby="abstract-title">
          <h2 id="abstract-title">Abstract</h2>
          <p>{metadata.abstract}</p>
        </section>

        <article class="manuscript">
          <slot />
        </article>
      </main>

      <aside class="margin-note" aria-hidden="true">
        <span>{metadata.version}</span>
        <span>EndoBio Research</span>
      </aside>
    </div>

    <footer class="site-footer">
      <span>© {new Date().getUTCFullYear()} EndoBio</span>
      <span>{metadata.title}</span>
    </footer>
  </body>
</html>
